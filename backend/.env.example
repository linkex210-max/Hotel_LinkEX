DEBUG=False
SECRET_KEY=<generate-strong-random-50-char-secret-key>
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database (PostgreSQL / set USE_SQLITE=True for local dev only)
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hotel_db
DB_USER=hotel_user
DB_PASSWORD=<set-strong-database-password>
DB_HOST=db
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT Auth (must be distinct and >= 32 chars in production)
JWT_SECRET_KEY=<generate-strong-random-jwt-secret-key>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ZATCA Tax Compliance
ZATCA_SELLER_VAT_NUMBER=<15-digit-vat-number-starting-and-ending-with-3>
