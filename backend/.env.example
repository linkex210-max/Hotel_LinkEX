DEBUG=True
SECRET_KEY=django-insecure-hotel-linkex-dev-secret-key-change-in-production-2026
ALLOWED_HOSTS=*

# Database (PostgreSQL / SQLite fallback if DB is not configured)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hotel_db
DB_USER=hotel_user
DB_PASSWORD=hotel_pass123
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT Auth
JWT_SECRET_KEY=hotel-linkex-jwt-secret-key-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ZATCA Tax Compliance
ZATCA_SELLER_VAT_NUMBER=300000000000003
