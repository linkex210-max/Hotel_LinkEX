{"openapi": "3.1.0", "info": {"title": "Hotel LinkEX API", "version": "1.0.0", "description": "\u0646\u0638\u0627\u0645 \u0625\u062f\u0627\u0631\u0629 \u0648\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0648\u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0633\u0643\u0646\u064a\u0629 - Hotel LinkEX Backend API"}, "paths": {"/api/users/login": {"post": {"operationId": "apps_users_api_login", "summary": "Login", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenOutSchema"}}}}, "401": {"description": "Unauthorized", "content": {"application/json": {"schema": {"additionalProperties": true, "title": "Response", "type": "object"}}}}}, "description": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0648\u0625\u0635\u062f\u0627\u0631 \u0631\u0645\u0648\u0632 JWT", "tags": ["Users & Auth"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginSchema"}}}, "required": true}}}, "/api/users/register": {"post": {"operationId": "apps_users_api_register", "summary": "Register", "parameters": [], "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserOutSchema"}}}}, "400": {"description": "Bad Request", "content": {"application/json": {"schema": {"additionalProperties": true, "title": "Response", "type": "object"}}}}}, "description": "\u0625\u0646\u0634\u0627\u0621 \u0645\u0633\u062a\u062e\u062f\u0645 \u062c\u062f\u064a\u062f", "tags": ["Users & Auth"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserCreateSchema"}}}, "required": true}}}, "/api/users/me": {"get": {"operationId": "apps_users_api_get_current_user", "summary": "Get Current User", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserOutSchema"}}}}}, "description": "\u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062d\u0627\u0644\u064a", "tags": ["Users & Auth"], "security": [{"JWTAuth": []}]}}, "/api/users/team": {"get": {"operationId": "apps_users_api_list_team_members", "summary": "List Team Members", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/UserOutSchema"}, "title": "Response", "type": "array"}}}}}, "description": "\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0641\u0631\u064a\u0642", "tags": ["Users & Auth"], "security": [{"JWTAuth": []}]}}, "/api/users/property-scope": {"post": {"operationId": "apps_users_api_assign_property_scope", "summary": "Assign Property Scope", "parameters": [], "responses": {"200": {"description": "OK"}}, "description": "\u062a\u062d\u062f\u064a\u062f \u0646\u0637\u0627\u0642 \u0648\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0649 \u0645\u0628\u0646\u0649 \u0645\u0639\u064a\u0646", "tags": ["Users & Auth"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PermissionUpdateSchema"}}}, "required": true}, "security": [{"JWTAuth": []}]}}, "/api/properties/": {"get": {"operationId": "apps_properties_api_list_properties", "summary": "List Properties", "parameters": [{"in": "query", "name": "city", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "City"}, "required": false}, {"in": "query", "name": "property_type", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Property Type"}, "required": false}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/PropertyOut"}, "title": "Response", "type": "array"}}}}}, "description": "\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0648\u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0641\u0644\u062a\u0631\u0629", "tags": ["Properties & Units"]}, "post": {"operationId": "apps_properties_api_create_property", "summary": "Create Property", "parameters": [], "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PropertyOut"}}}}, "403": {"description": "Forbidden", "content": {"application/json": {"schema": {"additionalProperties": true, "title": "Response", "type": "object"}}}}}, "description": "\u0625\u0636\u0627\u0641\u0629 \u0645\u0628\u0646\u0649 \u0623\u0648 \u0641\u0646\u062f\u0642 \u062c\u062f\u064a\u062f (\u0644\u0644\u0645\u062f\u0631\u0627\u0621 \u0641\u0642\u0637)", "tags": ["Properties & Units"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PropertyIn"}}}, "required": true}, "security": [{"JWTAuth": []}]}}, "/api/properties/{property_id}/room-types": {"get": {"operationId": "apps_properties_api_list_room_types", "summary": "List Room Types", "parameters": [{"in": "path", "name": "property_id", "schema": {"title": "Property Id", "type": "integer"}, "required": true}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/RoomTypeOut"}, "title": "Response", "type": "array"}}}}}, "description": "\u0639\u0631\u0636 \u0641\u0626\u0627\u062a \u0627\u0644\u063a\u0631\u0641 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0641\u064a \u0645\u0628\u0646\u0649/\u0641\u0646\u062f\u0642 \u0645\u0639\u064a\u0646", "tags": ["Properties & Units"]}}, "/api/properties/room-types": {"post": {"operationId": "apps_properties_api_create_room_type", "summary": "Create Room Type", "parameters": [], "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomTypeOut"}}}}, "403": {"description": "Forbidden", "content": {"application/json": {"schema": {"additionalProperties": true, "title": "Response", "type": "object"}}}}}, "description": "\u0625\u0646\u0634\u0627\u0621 \u0641\u0626\u0629 \u063a\u0631\u0641\u0629 \u062c\u062f\u064a\u062f\u0629 (\u0645\u062b\u0644 \u062f\u064a\u0644\u0648\u0643\u0633\u060c \u062c\u0646\u0627\u062d \u0639\u0627\u0626\u0644\u064a)", "tags": ["Properties & Units"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomTypeIn"}}}, "required": true}, "security": [{"JWTAuth": []}]}}, "/api/properties/{property_id}/units": {"get": {"operationId": "apps_properties_api_list_units", "summary": "List Units", "parameters": [{"in": "path", "name": "property_id", "schema": {"title": "Property Id", "type": "integer"}, "required": true}, {"in": "query", "name": "room_type_id", "schema": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Room Type Id"}, "required": false}, {"in": "query", "name": "status", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Status"}, "required": false}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/UnitOut"}, "title": "Response", "type": "array"}}}}}, "description": "\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0648\u0627\u0644\u063a\u0631\u0641 \u0627\u0644\u0641\u0639\u0644\u064a\u0629", "tags": ["Properties & Units"], "security": [{"JWTAuth": []}]}}, "/api/properties/units": {"post": {"operationId": "apps_properties_api_create_unit", "summary": "Create Unit", "parameters": [], "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UnitOut"}}}}, "400": {"description": "Bad Request", "content": {"application/json": {"schema": {"additionalProperties": true, "title": "Response", "type": "object"}}}}, "403": {"description": "Forbidden", "content": {"application/json": {"schema": {"additionalProperties": true, "title": "Response", "type": "object"}}}}}, "description": "\u0625\u0636\u0627\u0641\u0629 \u063a\u0631\u0641\u0629 \u0623\u0648 \u0648\u062d\u062f\u0629 \u0633\u0643\u0646\u064a\u0629 \u0628\u0631\u0642\u0645\u0647\u0627 \u0627\u0644\u0641\u0639\u0644\u064a", "tags": ["Properties & Units"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/UnitIn"}}}, "required": true}, "security": [{"JWTAuth": []}]}}, "/api/properties/room-types/{room_type_id}/inventory": {"get": {"operationId": "apps_properties_api_get_room_type_inventory", "summary": "Get Room Type Inventory", "parameters": [{"in": "path", "name": "room_type_id", "schema": {"title": "Room Type Id", "type": "integer"}, "required": true}, {"in": "query", "name": "start_date", "schema": {"format": "date", "title": "Start Date", "type": "string"}, "required": true}, {"in": "query", "name": "end_date", "schema": {"format": "date", "title": "End Date", "type": "string"}, "required": true}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/InventoryDayOut"}, "title": "Response", "type": "array"}}}}}, "description": "\u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u062a\u0648\u0641\u0631 \u0648\u0623\u0633\u0639\u0627\u0631 \u0641\u0626\u0629 \u0627\u0644\u063a\u0631\u0641\u0629 \u0639\u0628\u0631 \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u064a\u0648\u0645\u064a \u0627\u0644\u0633\u0631\u064a\u0639", "tags": ["Properties & Units"], "security": [{"JWTAuth": []}]}}, "/api/properties/pricing-rules": {"post": {"operationId": "apps_properties_api_create_pricing_rule", "summary": "Create Pricing Rule", "parameters": [], "responses": {"200": {"description": "OK"}}, "description": "\u0625\u0646\u0634\u0627\u0621 \u0642\u0627\u0639\u062f\u0629 \u062a\u0633\u0639\u064a\u0631 \u0645\u0648\u0633\u0645\u064a \u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a", "tags": ["Properties & Units"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PricingRuleSchema"}}}, "required": true}, "security": [{"JWTAuth": []}]}}, "/api/bookings/check-availability": {"post": {"operationId": "apps_bookings_api_check_availability", "summary": "Check Availability", "parameters": [], "responses": {"200": {"description": "OK"}}, "description": "\u0641\u062d\u0635 \u062a\u0648\u0641\u0631 \u0627\u0644\u063a\u0631\u0641 \u0627\u0644\u064a\u0648\u0645\u064a \u0641\u0627\u0626\u0642 \u0627\u0644\u0633\u0631\u0639\u0629 O(1)", "tags": ["Bookings & Engine"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AvailabilityCheck"}}}, "required": true}}}, "/api/bookings/": {"post": {"operationId": "apps_bookings_api_create_booking", "summary": "Create Booking", "parameters": [], "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BookingOut"}}}}, "400": {"description": "Bad Request", "content": {"application/json": {"schema": {"additionalProperties": true, "title": "Response", "type": "object"}}}}}, "description": "\u0625\u0646\u0634\u0627\u0621 \u062d\u062c\u0632 \u062c\u062f\u064a\u062f \u0644\u0644\u0646\u0632\u064a\u0644 \u0630\u0631\u064a\u0627\u064b \u0645\u0639 \u0645\u0646\u0639 \u0627\u0644\u0640 Double-Booking", "tags": ["Bookings & Engine"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/BookingIn"}}}, "required": true}, "security": [{"JWTAuth": []}]}}, "/api/bookings/{booking_id}/assign-room": {"post": {"operationId": "apps_bookings_api_assign_room", "summary": "Assign Room", "parameters": [{"in": "path", "name": "booking_id", "schema": {"title": "Booking Id", "type": "integer"}, "required": true}], "responses": {"200": {"description": "OK"}}, "description": "\u062a\u0633\u0643\u064a\u0646 \u0627\u0644\u0646\u0632\u064a\u0644 \u0648\u062a\u0639\u064a\u064a\u0646 \u0631\u0642\u0645 \u0627\u0644\u063a\u0631\u0641\u0629 \u0627\u0644\u0641\u0639\u0644\u064a (\u0628\u0648\u0627\u0633\u0637\u0629 \u0645\u0648\u0638\u0641 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644)", "tags": ["Bookings & Engine"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AssignRoomIn"}}}, "required": true}, "security": [{"JWTAuth": []}]}}, "/api/bookings/{booking_id}/confirm": {"post": {"operationId": "apps_bookings_api_confirm_booking", "summary": "Confirm Booking", "parameters": [{"in": "path", "name": "booking_id", "schema": {"title": "Booking Id", "type": "integer"}, "required": true}], "responses": {"200": {"description": "OK"}}, "description": "\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062d\u062c\u0632", "tags": ["Bookings & Engine"], "security": [{"JWTAuth": []}]}}, "/api/bookings/{booking_id}/check-in": {"post": {"operationId": "apps_bookings_api_check_in", "summary": "Check In", "parameters": [{"in": "path", "name": "booking_id", "schema": {"title": "Booking Id", "type": "integer"}, "required": true}], "responses": {"200": {"description": "OK"}}, "description": "\u062a\u0633\u062c\u064a\u0644 \u062f\u062e\u0648\u0644 \u0627\u0644\u0646\u0632\u064a\u0644 (Check-in) \u0648\u062a\u062d\u062f\u064a\u062b \u062d\u0627\u0644\u0629 \u0627\u0644\u063a\u0631\u0641\u0629 \u0644\u0645\u0634\u063a\u0648\u0644\u0629", "tags": ["Bookings & Engine"], "security": [{"JWTAuth": []}]}}, "/api/bookings/{booking_id}/check-out": {"post": {"operationId": "apps_bookings_api_check_out", "summary": "Check Out", "parameters": [{"in": "path", "name": "booking_id", "schema": {"title": "Booking Id", "type": "integer"}, "required": true}], "responses": {"200": {"description": "OK"}}, "description": "\u062a\u0633\u062c\u064a\u0644 \u062e\u0631\u0648\u062c \u0627\u0644\u0646\u0632\u064a\u0644 (Check